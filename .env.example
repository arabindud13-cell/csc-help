# Server Configuration (No API keys or external environment variables required)
PORT=3000

# SMS Gateway Configuration (Optional environment overrides)
# Can also be entered dynamically via Settings > SMS Gateway in the app UI
SMS_GATEWAY_PROVIDER="fast2sms"

# Fast2SMS (Direct Indian SMS and OTP)
FAST2SMS_API_KEY=""

# Twilio (Global Cloud Communications)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# MSG91 (Flow & OTP API)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
